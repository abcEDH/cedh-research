# PostHog Configuration
# Get your project token from: https://app.posthog.com/project/settings

# Client-side token (exposed to browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_ph_project_token_here

# PostHog host (use eu.i.posthog.com for EU region)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Enable debug mode in development
# NEXT_PUBLIC_POSTHOG_DEBUG=false
