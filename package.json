{
  "name": "cedh-research",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "docs:check": "node scripts/check-mermaid.mjs",
    "docs:hygiene": "node scripts/check-repo-hygiene.mjs",
    "vercel-build": "cd apps/web && next build",
    "verify:frontend": "./scripts/verify-frontend.sh",
    "preview:frontend": "./scripts/deploy-frontend-preview.sh",
    "web:dev": "cd apps/web && next dev",
    "web:build": "cd apps/web && next build",
    "web:start": "cd apps/web && next start",
    "web:lint": "cd apps/web && eslint",
    "web:test": "cd apps/web && vitest",
    "web:test:ci": "cd apps/web && vitest run",
    "web:test:contracts": "cd apps/web && vitest run tests/contracts",
    "web:test:e2e": "cd apps/web && playwright test",
    "web:test:e2e:url": "cd apps/web && BASE_URL=$npm_config_base_url playwright test",
    "web:test:e2e:ui": "cd apps/web && playwright test --ui",
    "web:test:e2e:prod": "cd apps/web && BASE_URL=${BASE_URL:-https://tedh.gg} playwright test",
    "backend:install": "python -m pip install -r packages/backend/requirements.txt",
    "backend:ingest": "python packages/backend/src/ingest.py"
  }
}
