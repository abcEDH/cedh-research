# Copy this file to .env and replace every placeholder with a real value.
# Keep .env out of git. For local development, run:
#   set -a && source .env && set +a && npm run web:dev

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend ingestion only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
DB_PASSWORD=your-db-password
DATABASE_URL=postgres://postgres:[password]@db.[project-id].supabase.co:5432/postgres
TOPDECK_API_KEY=your-topdeck-api-key

# -----------------------------------------------------------------------------
# PostHog browser analytics
# NEXT_PUBLIC_* values are bundled into the browser and must not be secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://metrics.tedh.gg

# -----------------------------------------------------------------------------
# Internal PostHog usage dashboard
# These values are server-only. Never rename the two API credentials with a
# NEXT_PUBLIC_ prefix.
# -----------------------------------------------------------------------------
POSTHOG_PERSONAL_API_KEY=your-posthog-personal-api-key
POSTHOG_PROJECT_ID=371705
POSTHOG_API_HOST=https://us.posthog.com
ANALYTICS_DASHBOARD_USERNAME=your-dashboard-username
ANALYTICS_DASHBOARD_PASSWORD=use-a-long-random-password
