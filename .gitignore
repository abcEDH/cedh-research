# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
apps/web/coverage/
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/playwright/.cache/

# next.js
/.next/
/out/
apps/web/.next/
apps/web/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# supabase
/supabase/.temp/

# python
**/__pycache__/
**/*.py[cod]

# typescript
*.tsbuildinfo
next-env.d.ts
